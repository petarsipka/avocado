        $i: Incident(flightId == $f.flightId, isDowngraded == true)
        $p: Passenger(flightId == $f.flightId)
        not Compensation(article == "Art. 10(2)(c)")
    then
        insert(new Compensation("Art. 10(2)(c)", $p.getTicketPrice() * 0.75, "Downgrade refund 75% of ticket price"));
