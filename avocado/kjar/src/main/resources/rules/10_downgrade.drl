        not Compensation(article == "Art. 10(2)(b)")
    then
        insert(new Compensation("Art. 10(2)(b)", $p.getTicketPrice() * 0.50, "Downgrade refund 50% of ticket price"));
end

rule "Downgrade refund LONG - 75%"
