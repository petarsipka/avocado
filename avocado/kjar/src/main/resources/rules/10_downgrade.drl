package rules;

import com.app.*;

rule "Downgrade refund SHORT - 30%"
    agenda-group "level3"
    when
        $f: Flight(distanceCategory == DistanceCategory.SHORT)
        $i: Incident(flightId == $f.flightId, isDowngraded == true)
        $p: Passenger(flightId == $f.flightId)
        not Compensation(article == "Art. 10(2)(a)")
    then
        insert(new Compensation("Art. 10(2)(a)", $p.getTicketPrice() * 0.30, "Downgrade refund 30% of ticket price"));
end

rule "Downgrade refund MEDIUM - 50%"
    agenda-group "level3"
    when
